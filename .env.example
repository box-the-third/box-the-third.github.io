# Copy to .env.local (gitignored). Only PUBLIC, RLS-protected values go in NEXT_PUBLIC_*.
# NEVER put service_role, Gemini, payment or bank secrets here — those live in
# Supabase Edge Function secrets (see supabase/README.md).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_N8N_WEBHOOK=http://localhost:5678/webhook/yas-social
